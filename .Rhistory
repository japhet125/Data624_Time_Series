fit2 <- train2 |>
model(SNAIVE(Turnover))
fit3 <- train3 |>
model(SNAIVE(Turnover))
test <- myseries |>
filter(year(Month) >= 2011)
fc1 <- fit1 |> forecast(new_data = test)
fc2 <- fit2 |> forecast(new_data = test)
fc3 <- fit3 |> forecast(new_data = test)
fc1 |> accuracy(myseries)
fc2 |> accuracy(myseries)
fc3 |> accuracy(myseries)
